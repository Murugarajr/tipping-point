# Local automated-test application settings. Committed and non-secret.
# Loaded only by the pytest bootstrap (tests/conftest.py) in place of a private .env.
# Plain-HTTP cookies are allowed only because the test client and loopback servers use http://.
# Never add credentials, keys, database URLs or hosted settings here.
TIPPING_POINT_ENV=local
TIPPING_POINT_ALLOW_INSECURE_DEV_COOKIES=true
