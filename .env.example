# Copy this file to .env and fill in the values for your local environment.
# Never commit .env with real credentials.

TIPPING_POINT_HOST=localhost
TIPPING_POINT_PORT=5432
TIPPING_POINT_USER=tipping_point_app
TIPPING_POINT_PASSWORD=
TIPPING_POINT_NAME=tipping_point_dev

# Application / session / CSRF / origin settings
# Use TIPPING_POINT_ENV=hosted and TIPPING_POINT_COOKIE_SECURE=true in hosted deployments.
TIPPING_POINT_ENV=local
TIPPING_POINT_COOKIE_SECURE=false
TIPPING_POINT_ALLOW_INSECURE_DEV_COOKIES=false
TIPPING_POINT_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000
TIPPING_POINT_SESSION_TTL_HOURS=12
TIPPING_POINT_THROTTLE_MAX_FAILURES=5
TIPPING_POINT_THROTTLE_WINDOW_MINUTES=15
# Optional Channel3 product search. Key is read only by the backend.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_TIMEOUT_SECONDS=10
CHANNEL3_OFFER_STALE_AFTER_SECONDS=3600

# Optional PayPal Sandbox adapter credentials. Server-side only; never commit
# populated values. Live mode is intentionally unsupported.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TIMEOUT_SECONDS=10

# Guest Sandbox reservations require both server-side expectations below.
# Use the confirmed Sandbox merchant/payee identifier; never a browser-supplied ID.
PAYPAL_EXPECTED_PAYEE=
# Approved browser origin used to generate fixed booking return/cancel routes.
# Hosted use requires HTTPS. This does not approve a development DB migration.
APP_PUBLIC_URL=http://localhost:5173
