# Frontend (Vite) variables. Copy to .env.local, which is git-ignored.
# Only VITE_* values reach the browser bundle. Never put PayPal, Channel3 or model-provider secrets here.

# AG Studio licence key (45-day trial or commercial). AG Studio documents applying it in client code via
# <AgStudioProvider licenseKey>, so it is embedded in the built JavaScript. Leave blank to run with the
# vendor watermark (documented local testing).
VITE_AG_STUDIO_LICENSE_KEY=

# Bryntum Gantt licence key (Business tier, 8.x). Bryntum documents registering it in the browser as
# globalThis.bryntum.licenseKey, so it is embedded in the built JavaScript. Leave blank to run in Bryntum's
# standard trial mode.
VITE_BRYNTUM_LICENSE_KEY=
